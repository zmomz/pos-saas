# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- Databases / local data ----
*.db
*.sqlite
*.sqlite3
# SQLite backups, e.g. seed_demo.py --rebuild writes app.db.bak (ARC-01)
*.bak
*.db.bak
# Postgres PITR archives written by `python -m services.backup` (M10 Ops / #211)
*.dump
backups/
backend/backups/
backend/app.db
backend/tests/_test_app.db
backend/_alembic_baseline.db

# ---- Logs ----
logs/
*.log

# ---- Runtime uploads (user-supplied; created on demand) ----
backend/uploads/

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---- Test artifacts ----
frontend/test-results/
frontend/playwright-report/
frontend/coverage/
backend/.coverage
backend/coverage.xml
backend/htmlcov/

# ---- Scratch / playground (not part of the app) ----
sandcastle-playground/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# pnpm content-addressable store (created when installing in-sandbox)
.pnpm-store/
