# ---- Frontend configuration (copy to frontend/.env) ----

# Base URL of the backend API. In local dev the Vite proxy also forwards /api
# to the backend, but setting this makes the built site talk to the API directly.
VITE_API_BASE_URL=http://localhost:8000

# Optional: branding shown in the browser tab / SEO
# VITE_APP_TITLE=POS System
# VITE_APP_DESCRIPTION=Multi-tenant POS System
