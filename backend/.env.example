# ---- Backend configuration (copy to backend/.env) ----

# Database. SQLite works out of the box for a single server; for production use
# Postgres, e.g. postgresql://user:password@localhost:5432/posdb
DATABASE_URL=sqlite:///./app.db

# Server
HOST=0.0.0.0
PORT=8000
# Set to "dev" to return full tracebacks on 500 errors
ENVIRONMENT=prod

# JWT — CHANGE THE SECRET to a long random string in production
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Master/admin account seeded on first startup (this account is the platform "master")
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Administrator

# Allow open self-registration via POST /api/v1/auth/register.
# Recommended: false in production (provision accounts instead).
ALLOW_REGISTRATION=true

# CORS: comma-separated exact origins allowed to call the API with credentials
# (e.g. https://app.example.com,https://admin.example.com). Leave blank for a
# same-origin deployment (dev allows any origin without credentials; prod falls
# back to localhost only).
# ALLOWED_ORIGINS=

# Refresh-cookie cross-site mode (ISSUE-185). Leave false for the same-origin
# default: the refresh cookie is SameSite=Lax. Set true ONLY when the SPA and API
# are served on different sites — the cookie becomes SameSite=None; Secure so
# /auth/refresh keeps working across the origin split. Requires ALLOWED_ORIGINS
# to be set (prod refuses to boot otherwise) since SameSite=None needs
# credentialed CORS pinned to explicit origins.
# REFRESH_COOKIE_CROSS_SITE=false

# Optional integrations (leave blank to disable)
# STRIPE_SECRET_KEY=
# OPENAI_API_KEY=
