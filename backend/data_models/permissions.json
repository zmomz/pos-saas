{
    "title": "permissions",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "user_id": {
            "type": "string",
            "description": "User ID"
        },
        "role": {
            "type": "string",
            "description": "Role name: master, agent, client, staff"
        },
        "permission_key": {
            "type": "string",
            "description": "Permission key like pos.refund, products.edit, reports.view"
        },
        "is_granted": {
            "type": "boolean",
            "description": "Whether permission is granted"
        },
        "granted_by": {
            "type": "string",
            "description": "User ID who granted this permission"
        }
    },
    "required": [
        "id",
        "user_id",
        "role",
        "permission_key",
        "is_granted"
    ]
}