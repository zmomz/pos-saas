{
    "title": "transactions",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "user_id": {
            "type": "string",
            "description": "User ID (client owner)"
        },
        "client_id": {
            "type": "integer",
            "description": "Reference to client"
        },
        "invoice_number": {
            "type": "string",
            "description": "Sequential invoice number"
        },
        "subtotal": {
            "type": "number",
            "description": "Subtotal before tax"
        },
        "vat_amount": {
            "type": "number",
            "description": "VAT amount"
        },
        "discount_amount": {
            "type": "number",
            "description": "Discount amount",
            "default": 0
        },
        "total_amount": {
            "type": "number",
            "description": "Total amount including tax"
        },
        "payment_method": {
            "type": "string",
            "description": "Payment method: cash, card, bank_transfer"
        },
        "status": {
            "type": "string",
            "description": "Transaction status: completed, refunded, pending",
            "default": "completed"
        },
        "zatca_qr": {
            "type": "string",
            "description": "ZATCA QR code data (TLV encoded)"
        },
        "zatca_hash": {
            "type": "string",
            "description": "Cryptographic hash for ZATCA"
        },
        "items_json": {
            "type": "string",
            "description": "JSON string of transaction items"
        },
        "customer_name": {
            "type": "string",
            "description": "Customer name if provided"
        },
        "customer_phone": {
            "type": "string",
            "description": "Customer phone if provided"
        }
    },
    "required": [
        "id",
        "user_id",
        "client_id",
        "invoice_number",
        "total_amount",
        "payment_method"
    ]
}